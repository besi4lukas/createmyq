# Local-only environment for wrangler/vite (not Worker secrets). Copy to .env (gitignored).

# STM-3: Neon connection string that wrangler dev and `npm run dev` use in place of the
# Hyperdrive binding. wrangler reads this from .env or the shell, NOT from .dev.vars.
# Get it with: neon connection-string production   (drop the channel_binding param)
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=

# STM-5: Clerk publishable key (from the dev instance), baked into the SPA by Vite.
# Put it in .env.local. CI reads it from the GitHub variable VITE_CLERK_PUBLISHABLE_KEY.
VITE_CLERK_PUBLISHABLE_KEY=

# STM-27: Sentry DSN for the SPA (the createmyq-web project). Optional; unset = no Sentry
# in the bundle. Public by design, like the Clerk key. CI: GitHub variable VITE_SENTRY_DSN.
# VITE_SENTRY_DSN=

# STM-27: `npm run report` reads REPORT_DATABASE_URL if set, else DATABASE_URL_UNPOOLED.
# REPORT_DATABASE_URL=
