{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "createmyq",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-09-25",
  // node-postgres (pg) needs Node APIs (net, tls, crypto) to talk to Hyperdrive.
  "compatibility_flags": ["nodejs_compat"],
  // Frontend is built by Vite and served from the same Worker (Workers Assets).
  // /api/* always hits the Worker first; everything else falls back to the SPA.
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true
  },
  // Neon Postgres (project sweet-pine-24006217, branch production) via Hyperdrive.
  // Locally, wrangler dev reads CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE from .dev.vars.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "02d4ca5e5664448bb41400bfff148cf7"
    }
  ]
  // STM-5: sign-in is Clerk. The Worker verifies session tokens with the secret
  // CLERK_JWT_KEY (Clerk dashboard → API keys → JWKS Public Key, PEM). It is a
  // secret, not a var: `npx wrangler secret put CLERK_JWT_KEY` in prod, .dev.vars locally.
  // Bindings arrive with their tickets, not before:
  //   STM-9  Durable Object: user session
  //   STM-13 R2 bucket for uploads
  //   STM-15 Queue + Workflow
  //   STM-16 Durable Object: generation lock
  //   STM-18 AI Gateway
}
