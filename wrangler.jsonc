{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "createmyq",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-09-25",
  // node-postgres (pg) needs Node APIs (net, tls, crypto) to talk to Hyperdrive.
  "compatibility_flags": ["nodejs_compat"],
  // Frontend is built by Vite and served from the same Worker (Workers Assets).
  // /api/* always hits the Worker first; everything else falls back to the SPA.
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true
  },
  // Neon Postgres (project sweet-pine-24006217, branch production) via Hyperdrive.
  // Locally, wrangler dev reads CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE from .dev.vars.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "02d4ca5e5664448bb41400bfff148cf7"
    }
  ],
  // STM-9: one UserSession per user (idFromName(users.id)): the quiz in progress
  // and preferences. SQLite-backed; the class is exported from worker/index.ts.
  // STM-16: one GenerationLock per content fingerprint (idFromName(fingerprint)):
  // which Workflow run may fill that content's question bank right now.
  "durable_objects": {
    "bindings": [
      { "name": "USER_SESSION", "class_name": "UserSession" },
      { "name": "GENERATION_LOCK", "class_name": "GenerationLock" }
    ]
  },
  // Never edit or remove an applied migration; add a new tag instead.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["UserSession"] },
    { "tag": "v2", "new_sqlite_classes": ["GenerationLock"] }
  ],
  // STM-13: PDF uploads. The browser PUTs straight to R2 with a presigned URL
  // (S3 API, signed in worker/uploads/presign.ts); the Worker only signs and
  // then HEADs the object through this binding. `remote: true` so local dev
  // reads the same bucket the presigned URL writes to: the dev bucket
  // (preview_bucket_name), never production. Bucket CORS must allow PUT from
  // the app origin(s); see CLAUDE.md.
  "r2_buckets": [
    {
      "binding": "UPLOADS",
      "bucket_name": "createmyq-uploads",
      "preview_bucket_name": "createmyq-uploads-dev",
      "remote": true
    }
  ],
  // Signing needs the account's S3 endpoint and the bucket's name (the binding
  // doesn't expose it). .dev.vars sets UPLOADS_BUCKET_NAME=createmyq-uploads-dev.
  // The R2 API token is two secrets: R2_ACCESS_KEY_ID and R2_SECRET_ACCESS_KEY.
  // STM-18: question generation calls Anthropic through the AI Gateway
  // `createmyq` (create it first: dashboard → AI → AI Gateway). The key is the
  // secret ANTHROPIC_API_KEY. GENERATION_ENABLED is the kill switch: anything
  // but "true" fails every new run with a clear message before any model call.
  // Off until STM-24's daily cap and spend ceiling exist; .dev.vars turns it on locally.
  "vars": {
    "R2_ACCOUNT_ID": "037430f3820d50ee00c0ee8ed692bc00",
    "UPLOADS_BUCKET_NAME": "createmyq-uploads",
    "AI_GATEWAY_URL": "https://gateway.ai.cloudflare.com/v1/037430f3820d50ee00c0ee8ed692bc00/createmyq/anthropic",
    "GENERATION_ENABLED": "false"
  },
  // STM-15: making questions runs in the background, never in a request or a
  // user's Durable Object. POST /api/uploads/complete sends { sourceId } to the
  // queue; the consumer (worker/workflows/queue.ts) starts one GenerationWorkflow
  // run per source. Both queues must exist before deploy:
  //   npx wrangler queues create createmyq-generation
  //   npx wrangler queues create createmyq-generation-dlq
  "queues": {
    "producers": [{ "binding": "GENERATION_QUEUE", "queue": "createmyq-generation" }],
    "consumers": [
      {
        "queue": "createmyq-generation",
        // One message per batch: each upload starts its run at once.
        "max_batch_size": 1,
        "max_retries": 5,
        // Nothing reads the DLQ yet; it keeps the message for an operator.
        "dead_letter_queue": "createmyq-generation-dlq"
      }
    ]
  },
  // STM-19: Workers AI embeds generated questions for the near-duplicate
  // filter (worker/workflows/embed.ts). It always runs on Cloudflare, also in
  // local dev, and is billed there too (well under $0.001 per source).
  "ai": { "binding": "AI", "remote": true },
  "workflows": [
    { "name": "createmyq-generation", "binding": "GENERATION_WORKFLOW", "class_name": "GenerationWorkflow" }
  ]
  // STM-5: sign-in is Clerk. The Worker verifies session tokens with the secret
  // CLERK_JWT_KEY (Clerk dashboard → API keys → JWKS Public Key, PEM). It is a
  // secret, not a var: `npx wrangler secret put CLERK_JWT_KEY` in prod, .dev.vars locally.
}
